# Local server.py (optional). Without these, Moru still answers with the local shop brain.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# MORU_MODEL=gpt-4o-mini

# Production (Cloudflare Pages project: longying-studio):
# npx wrangler pages secret put OPENAI_API_KEY --project-name longying-studio
# Optional:
# npx wrangler pages secret put OPENAI_BASE_URL --project-name longying-studio
# npx wrangler pages secret put MORU_MODEL --project-name longying-studio
