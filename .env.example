# ===== 2015 本机服务器（DeepSeek）=====
# 把本文件复制为 .env 后填入密钥，再重启 python3 server.py
HOST=0.0.0.0
PORT=8787
OPENAI_API_KEY=sk-你的DeepSeek密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1
MORU_MODEL=deepseek-chat

# ===== 可选：Cloudflare 公网（moru-shop）=====
# npx wrangler pages secret put OPENAI_API_KEY --project-name moru-shop
# npx wrangler pages secret put OPENAI_BASE_URL --project-name moru-shop
# npx wrangler pages secret put MORU_MODEL --project-name moru-shop
